default_platform(:android)

platform :android do

  # Sast
  # Ejecuta un análisis de seguridad estática para detectar errores de código.
  # Uso: fastlane sast
  desc "Análisis de código estático (SAST) con Detekt"
  lane :sast do
    gradle(task: "clean :app:detekt")
    puts "--- Análisis SAST completado sin errores ---"
  end

  # Build completo
  # Limpia el proyecto, verifica la calidad del código y genera el APK de debug.
  # Uso: fastlane build
  desc "Genera el APK de debug listo para instalar"
  lane :build do
    gradle(task: "clean :app:detekt :app:assembleDebug")
    UI.success("APK generado en app/build/outputs/apk/debug/app-debug.apk")
  end

end